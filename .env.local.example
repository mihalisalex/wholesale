# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# SMTP credentials used to send order-request emails (Nodemailer).
# Works with any provider: your company mailbox, a Gmail app password,
# or an SMTP relay from Postmark/SendGrid/etc.
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=orders@hervefootwear.com
SMTP_PASS=your-smtp-password-or-app-token
SMTP_FROM="Hervé Footwear <orders@hervefootwear.com>"

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: set this to your domain (e.g. hervefootwear.com) to enable
# privacy-friendly Plausible analytics, gated behind the cookie banner.
# Leave unset to run with no analytics at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Admin dashboard (/admin) — single shared password, no user accounts.
# ADMIN_SESSION_SECRET should be a long random string (e.g. `openssl rand -hex 32`);
# it signs the login session cookie, so keep it secret and don't reuse it elsewhere.
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Postgres connection string (Neon, or any Postgres). Products, collections,
# orders and retailer accounts all live here — see lib/db/schema.ts.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs retailer account session cookies — a separate long random string from
# ADMIN_SESSION_SECRET (e.g. `openssl rand -hex 32`), so a leak of one secret
# doesn't affect the other.
RETAILER_SESSION_SECRET=replace-with-a-long-random-string
